@import "~/.config/colors/current/rofi.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    font:             "Terminess Nerd Font Bold 12";
}

window {
    width:            640px;
    background-color: @bg-dim;
    border:           3px;
    border-color:     @orange-br;
    padding:          0;
    children:         [ mainbox ];
}

mainbox {
    children: [ inputbar, listview, message ];
    spacing:  0;
}

inputbar {
    background-color: @bg;
    border:           0 0 2px 0;
    border-color:     @surface;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @orange-br;
}

entry {
    placeholder:       "SEARCH";
    placeholder-color: @fg-faint;
    cursor:            text;
}

listview {
    lines:        9;
    scrollbar:    false;
    padding:      6px 0;
    spacing:      0;
    fixed-height: false;
}

element {
    padding: 5px 14px;
    spacing: 10px;
}

element normal urgent {
    text-color: @red-br;
}

element normal active {
    text-color: @cyan-br;
}

element selected {
    background-color: @orange-br;
    text-color:       @bg-dim;
}

element selected urgent {
    background-color: @red;
    text-color:       @fg-hi;
}

element-icon {
    size:             1.1em;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

message {
    background-color: @bg;
    border:           2px 0 0 0;
    border-color:     @surface;
    padding:          8px 14px;
}

textbox {
    text-color: @fg-dim;
}
