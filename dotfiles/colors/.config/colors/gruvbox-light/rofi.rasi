* {
    bg-dim:     #f9f5d7;
    bg:         #fbf1c7;
    bg-raised:  #ebdbb2;
    surface:    #d5c4a1;
    surface-hi: #bdae93;
    overlay:    #a89984;

    fg-hi:      #282828;
    fg:         #3c3836;
    fg-dim:     #504945;
    fg-faint:   #665c54;

    red:        #cc241d;
    orange:     #d65d0e;
    yellow:     #d79921;
    green:      #98971a;
    cyan:       #689d6a;
    blue:       #458588;
    magenta:    #b16286;
    gray:       #7c6f64;

    red-br:     #9d0006;
    orange-br:  #af3a03;
    yellow-br:  #b57614;
    green-br:   #79740e;
    cyan-br:    #427b58;
    blue-br:    #076678;
