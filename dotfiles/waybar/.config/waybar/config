{
    "layer": "top",
    "position": "top",
    "height": 28,
    "modules-left": ["custom/terminal", "clock", "cpu", "memory", "tray"],
    "modules-center": ["ext/workspaces"],
    "modules-right": ["pulseaudio", "backlight", "bluetooth", "network", "battery"],

    "custom/terminal": {
        "format": "● CONSOLE",
        "tooltip": false
    },

    "clock": {
        "interval": 1,
        "format": "[  {:%T} ]",
        "tooltip": false
    },

    "cpu": {
        "interval": 2,
        "format": "[  {usage}% ]",
        "states": {
            "warning": 70,
            "critical": 85
        }
    },

    "memory": {
        "interval": 5,
        "format": "[  {percentage}% ]",
        "states": {
            "warning": 75,
            "critical": 90
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "ext/workspaces": {
        "format": "{icon}", 
        "all-outputs": false,
        "active-only": false,
        "format-icons": {
            "1": "CH01",
            "2": "CH02",
            "3": "CH03",
            "4": "CH04",
            "5": "CH05"
        }
    },

    "pulseaudio": {
        "format": "[ {icon}  {volume}% ]",
        "format-muted": "[ 󰖁  MUTE ]",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "backlight": {
        "interval": 2,
        "format": "[   {percent}% ]",
        "tooltip": false
    },

    "bluetooth": {
        "format": "[  {status} ]",
        "format-connected": "[  {device_alias} ]",
        "format-disabled": "[  OFF ]",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\n\nCONNECTED:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },

    "network": {
        "interval": 3,
        "format-wifi": "[   {essid} {signaldBm}dBm ]",
        "format-ethernet": "[   {ifname} ]",
        "format-disconnected": "[ 󰌙  OFFLINE ]",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "NETWORK_ID: {essid}\nIP_ADDR: {ipaddr}\nSIGNAL: {signaldBm}dBm ({signalStrength}%)",
        "tooltip-format-ethernet": "IFACE: {ifname}\nIP_ADDR: {ipaddr}\nSPEED: {bandwidthDownBits}↓ {bandwidthUpBits}↑",
        "tooltip-format-disconnected": "COMMS_STATUS: DISCONNECTED"
    },

    "battery": {
        "states": {
            "warning": 30,  /* Drops to orange alert below 30% */
            "critical": 15  /* Drops to flashing red panic below 15% */
        },
        "events": {
            "on-discharging-warning": "notify-send -u normal 'Battery Low'",
            "on-discharging-critical": "notify-send -u critical 'Battery Critical'",
            "on-charging-100": "notify-send -u normal 'Battery Full'",
            "on-discharging": "notify-send -u normal 'Power Switch' Discharging",
            "on-charging": "notify-send -u normal 'Power Switch' Charging'"
        },
        "format": "[ {icon}  {capacity}% ]",
        "format-charging": "[ 󱐋 {capacity}% ]",
        "format-plugged": "[  AC_PWR ]",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    },
}
